# ----------------------------------------------------------------------
# 1. PYTHON / DJANGO BACKEND IGNORES (Located in /django_backend)
# ----------------------------------------------------------------------

AiToolSuite/

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.so

# Django specific
*.sqlite3
/Django_Backend/media/   # User-uploaded files

# Environment Files (CRITICAL for security)
/django_backend/.env
/django_backend/.DS_Store  # macOS specific
/django_backend/chroma_db/*
/django_backend/*.log
/django_backend/*.bak
/django_backend/*.dat
/django_backend/*.dir

# Local settings file (if you use one to override sensitive production settings)
/django_backend/*/local_settings.py

# ----------------------------------------------------------------------
# 2. JAVASCRIPT / REACT FRONTEND IGNORES (Located in /react_frontend)
# ----------------------------------------------------------------------

# Dependencies and build output
/react_frontend/node_modules
/react_frontend/build  # Output directory for production build

# Environment Files (CRITICAL for security)
/react_frontend/.env
/react_frontend/.env.local
/react_frontend/.env.development.local
/react_frontend/.env.production.local

# Miscellaneous
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Django uploaded/generated media
Django_Backend/media/

# If you want to be more granular instead of ignoring all media, use:
# Django_Backend/media/**/*.png
# Django_Backend/media/**/*.jpg
# Django_Backend/media/**/*.jpeg
# Django_Backend/media/**/*.pdf
# Django_Backend/media/**/*.docx
# Django_Backend/media/**/*.json
# Django_Backend/media/**/*.jsonl
# Django_Backend/media/**/*.yaml
# Django_Backend/media/**/*.html
# Django_Backend/media/**/*.txt

# Threat model FAISS indexes (generated data)
Django_Backend/threat_model/faiss_indexes/

# FAISS / ML artifacts (extra safety)
*.faiss
*.pkl

# Postman exports
*.postman_collection.json
*.postman_environment.json